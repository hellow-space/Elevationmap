Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    Splitter Ratio: 0.5
  Tree Height: 336
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Class: grid_map_rviz_plugin/GridMap
    Color: 200; 200; 200
    Color Layer: elevation
    Color Transformer: IntensityLayer
    Enabled: true
    Height Layer: elevation
    Height Transformer: GridMapLayer
    History Length: 1
    Invert Rainbow: false
    Max Color: 240; 60; 35
    Max Intensity: 0.3
    Min Color: 30; 90; 210
    Min Intensity: -0.3
    Name: Height (m)
    Show Grid Lines: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain_geometry/elevation
    Use Rainbow: false
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Class: grid_map_rviz_plugin/GridMap
    Color: 200; 200; 200
    Color Layer: slope
    Color Transformer: IntensityLayer
    Enabled: true
    Height Layer: elevation
    Height Transformer: GridMapLayer
    History Length: 1
    Invert Rainbow: false
    Max Color: 240; 60; 35
    Max Intensity: 20.0
    Min Color: 30; 90; 210
    Min Intensity: 0.0
    Name: Slope (deg)
    Show Grid Lines: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain_geometry/slope
    Use Rainbow: false
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Class: grid_map_rviz_plugin/GridMap
    Color: 200; 200; 200
    Color Layer: roughness
    Color Transformer: IntensityLayer
    Enabled: true
    Height Layer: elevation
    Height Transformer: GridMapLayer
    History Length: 1
    Invert Rainbow: false
    Max Color: 240; 60; 35
    Max Intensity: 0.02
    Min Color: 30; 90; 210
    Min Intensity: 0.0
    Name: Roughness (m)
    Show Grid Lines: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain_geometry/roughness
    Use Rainbow: false
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Terrain labels
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /terrain_geometry/labels
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 32; 36; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.85
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.0
Window Geometry:
  Height: 900
  Width: 1600
  X: 0
  Y: 0
